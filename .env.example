# Content Creator Engine — environment template.
# Copy this file to `.env` and fill in real values:
#   cp .env.example .env
# NEVER commit `.env` or any real secret. Only `.env.example` (with placeholders)
# is tracked by git. The app fails fast at startup if a required var is missing
# or empty (see backend/app/config.py).

# Development and Production.
ENVIRONMENT=dev

# Semantic versioning (required, non-empty):
CC_VERSION=0.1.0

# PostgreSQL
POSTGRES_USER=fantasy_user
POSTGRES_PASSWORD=fantasy_pass
POSTGRES_DB=fantasy_db
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}

# Redis (required)
REDIS_URL=redis://redis:6379/0

# Secret key for JWT signing (required, non-empty).
# Generate a strong key with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# NEVER use an empty or example value in production — the app will refuse to start.
SECRET_KEY=

# CORS — comma-separated list of allowed frontend origins.
# Development default (localhost origins); set to your real domain in production.
ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://127.0.0.1

# Celery (broker + result backend). Empty values fall back to REDIS_URL on DBs 0/1.
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
BROKER_CONNECTION_RETRY_ON_STARTUP=True

# Watermarked media cache (Redis; defaults to REDIS_URL DB 2)
WATERMARK_CACHE_REDIS_URL=redis://redis:6379/2
# TTL in seconds before a cached watermarked media entry expires
WATERMARK_CACHE_TTL_SECONDS=3600

# JWT token revocation list (Redis; defaults to REDIS_URL DB 3)
TOKEN_REVOCATION_REDIS_URL=redis://redis:6379/3

# Payment gateway abstraction (mock | stripe | paypal).
# "mock" is the default so the stack runs with zero credentials; the
# subscription business logic is gateway-agnostic (see app/payments/).
PAYMENT_PROVIDER=mock
# Stripe credentials — required when PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_BASE=https://api.stripe.com/v1
# PayPal credentials — required when PAYMENT_PROVIDER=paypal
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENVIRONMENT=sandbox

# Single subscription tier (monthly). PLAN_ID is the gateway price id
# (e.g. a Stripe recurring price); PRICE_CENTS is informational for the API.
SUBSCRIPTION_TIER_PLAN_ID=price_monthly_tier
SUBSCRIPTION_TIER_PRICE_CENTS=500

# Payment-failure notifications (SMTP). All optional: when SMTP_HOST is empty,
# the notify task degrades to a structured log line (dev/mock setups).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=True

# Logging
LOG_LEVEL=INFO

# JWT token lifetimes (minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=21600
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# Sentry error tracking (optional)
SENTRY_DSN=

# Admin bootstrap defaults — override in production!
DEFAULT_ADMIN_EMAIL=admin@admin.com
DEFAULT_ADMIN_PASSWORD=admin
