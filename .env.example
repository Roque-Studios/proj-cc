# Content Creator Engine — environment template.
# Copy this file to `.env` and fill in real values:
#   cp .env.example .env
# NEVER commit `.env` or any real secret. Only `.env.example` (with placeholders)
# is tracked by git. The app fails fast at startup if a required var is missing
# or empty (see backend/app/config.py).

# Development and Production.
ENVIRONMENT=dev

# Semantic versioning (required, non-empty):
CC_VERSION=0.1.0

# PostgreSQL
POSTGRES_USER=fantasy_user
POSTGRES_PASSWORD=fantasy_pass
POSTGRES_DB=fantasy_db
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}

# Redis (required)
REDIS_URL=redis://redis:6379/0

# Secret key for JWT signing (required, non-empty).
# Generate a strong key with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# NEVER use an empty or example value in production — the app will refuse to start.
SECRET_KEY=

# CORS — comma-separated list of allowed frontend origins.
# Development default (localhost origins); set to your real domain in production.
ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://127.0.0.1

# Celery (broker + result backend). Empty values fall back to REDIS_URL on DBs 0/1.
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
BROKER_CONNECTION_RETRY_ON_STARTUP=True

# Watermarked media cache (Redis; defaults to REDIS_URL DB 2)
WATERMARK_CACHE_REDIS_URL=redis://redis:6379/2
# TTL in seconds before a cached watermarked media entry expires
WATERMARK_CACHE_TTL_SECONDS=3600

# JWT token revocation list (Redis; defaults to REDIS_URL DB 3)
TOKEN_REVOCATION_REDIS_URL=redis://redis:6379/3

# Payment gateway abstraction (mock | stripe | paypal).
# "mock" is the default so the stack runs with zero credentials; the
# subscription business logic is gateway-agnostic (see app/payments/).
PAYMENT_PROVIDER=mock
# Stripe credentials — required when PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_BASE=https://api.stripe.com/v1
# PayPal credentials — required when PAYMENT_PROVIDER=paypal
# Sandbox: create a sandbox REST app at developer.paypal.com and use its
# client id/secret; set PAYPAL_WEBHOOK_ID from a webhook you create there
# pointing at https://<your-host>/api/webhooks/paypal. For production, use the
# live app's credentials and PAYPAL_ENVIRONMENT=live.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENVIRONMENT=sandbox
# Optional catalog product (PROD-...) to attach billing plans to; when empty,
# the bootstrap script creates one.
PAYPAL_PRODUCT_ID=

# Wompi (El Salvador) — required when PAYMENT_PROVIDER=wompi
# Credentials from the Wompi Commerce dashboard (App ID / API Secret). The
# environment is per-app (sandbox vs production is set on the applicativo in
# the panel), not a URL switch; WOMPI_API_BASE_URL / WOMPI_TOKEN_URL overrides
# exist for test accounts. Webhooks: register POST /api/webhooks/wompi and
# Wompi signs each event with the `wompi_hash` header (HMAC-SHA256 of the raw
# body with your API Secret).
WOMPI_CLIENT_ID=
WOMPI_CLIENT_SECRET=
WOMPI_ENVIRONMENT=sandbox
WOMPI_API_BASE_URL=https://api.wompi.sv
WOMPI_TOKEN_URL=https://id.wompi.sv/connect/token
# Recurring subscriptions charge the subscriber on this day of each month.
WOMPI_DIA_DE_PAGO=1
# Return URL after the customer completes a 3DS one-time charge.
WOMPI_3DS_REDIRECT_URL=

# Single subscription tier (monthly).
# Stripe: PLAN_ID is a recurring price id (e.g. price_...).
# PayPal: PLAN_ID is the billing plan id (P-...) — create it with
#   docker compose exec api python -m app.payments.bootstrap_paypal
#   (creates a product + an ACTIVE monthly plan for SUBSCRIPTION_TIER_PRICE_CENTS)
# PRICE_CENTS is informational for the API.
SUBSCRIPTION_TIER_PLAN_ID=price_monthly_tier
SUBSCRIPTION_TIER_PRICE_CENTS=500

# Payment-failure notifications (SMTP). All optional: when SMTP_HOST is empty,
# the notify task degrades to a structured log line (dev/mock setups).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=True

# Photo-post media uploads (mounted as a docker volume in compose);
# MAX_MEDIA_SIZE_BYTES limits each upload. ORIGINAL_MEDIA_STORAGE_PATH is the
# PRIVATE store for unwatermarked originals — never served to clients, readable
# only by internal service code. Serving watermarks originals on the fly per
# viewer, so no served copy is persisted.
ORIGINAL_MEDIA_STORAGE_PATH=/data/media/original
MAX_MEDIA_SIZE_BYTES=10485760
ALLOWED_MEDIA_EXTENSIONS=.jpg,.jpeg,.png,.webp,.gif

# Logging
LOG_LEVEL=INFO

# JWT token lifetimes (minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=21600
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# Sentry error tracking (optional)
SENTRY_DSN=

# Admin bootstrap defaults — override in production!
DEFAULT_ADMIN_EMAIL=admin@admin.com
DEFAULT_ADMIN_PASSWORD=admin
